<?xml version="1.0" encoding="utf-8"?>
<!--
    targetSandboxVersion=2 must stay: the published 3.x APKs (Instant App era) declared it, and Google Play
    does not allow an update to go back to sandbox 1. The app has no network access, so the stricter sandbox
    changes nothing for it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:targetSandboxVersion="2">

    <!-- Creates the wake-up alarm in the system Clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- "Time to leave" notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: lets the "Before you leave" notification show as a Live Update (chip in the status bar) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Exact timing: user-granted below Android 13, granted automatically from 13 (alarm-clock app) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- In-app ringing alarm -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only to scan the QR code that switches the alarm off; optional -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:name=".ParakeetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Parakeet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Parakeet.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".alarm.AlarmReceiver" android:exported="false" />

        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Parakeet" />

        <!-- "After the alarm": ring + list. Shown over the lock screen (set in code, only when the user chose so)
             when started by our own AlarmActivity: no extra permission, no full-screen intent. -->
        <activity
            android:name=".ui.postwake.PostWakeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Parakeet" />
        <receiver android:name=".alarm.PostWakeReceiver" android:exported="false" />

        <receiver android:name=".alarm.ExitAlarmReceiver" android:exported="false" />
        <receiver android:name=".alarm.PlanReceiver" android:exported="false" />

        <receiver android:name=".alarm.RescheduleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
